<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:PresenceEtudiant.Mobile"
             x:Class="PresenceEtudiant.Mobile.ConnexionPage"
             Title="Connexion"
             Shell.NavBarIsVisible="False">
    <VerticalStackLayout Padding="16" Spacing="16" VerticalOptions="Center">
        <Label Text="Présence Étudiant" FontSize="24" FontAttributes="Bold" HorizontalOptions="Center" />
        <Entry Placeholder="Identifiant (e-mail)" Text="{Binding Email}" Keyboard="Email" HeightRequest="56" />
        <Entry Placeholder="Mot de passe" Text="{Binding MotDePasse}" IsPassword="True" HeightRequest="56" />
        <Label Text="{Binding Message}" TextColor="{StaticResource Erreur}" />
        <ActivityIndicator IsRunning="{Binding EnCours}" />
        <Button Text="Se connecter" Command="{Binding SeConnecterCommand}" HeightRequest="48" />
        <Button Text="Créer un compte" Command="{Binding CreerCompteCommand}" BackgroundColor="Transparent" TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
    </VerticalStackLayout>
</ContentPage>
